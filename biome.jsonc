{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.json"],
  "linter": {
    "rules": {
      "correctness": {
        // Our own hooks whose results keep their identity, like `useState`'s
        // setter, so they needn't be listed as dependencies.
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            "hooks": [{ "name": "useStateRef", "stableResult": [1, 2] }]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // A unit test is named for the module it covers (`conventions/ts-unit-testing.md`),
      // so a hook's test file carries that hook's camelCase name.
      "includes": ["**/__tests__/**/*.tsx"],
      "linter": {
        "rules": {
          // A case declares the components it renders inside itself, closing
          // over its own fixtures. Each is rendered once, so the identity the
          // rule guards across renders never comes into it.
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "kebab-case", "PascalCase"]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!conventions",
      "!!**/dist",
      "!!**/coverage",
      "!**/node_modules"
    ]
  }
}
